{
  "schema": "echo.sdk.template.v1",
  "id": "testkit-example",
  "name": "Testkit Example",
  "kind": "addon",
  "description": "Example scaffold for validation and testkit patterns.",
  "fileSets": ["addon-module"],
  "defaultValues": {
    "class_name": "TestkitExampleAddon",
    "kind": "native_example",
    "role": "testkit_example",
    "feature_id": "testkit.example",
    "display_name": "Testkit Example"
  },
  "tokens": {
    "module_id": {"required": true, "description": "Lowercase ECHO module id."},
    "package_path": {"required": true, "description": "Generated Java package path."},
    "package_name": {"required": true, "description": "Generated Java package name."},
    "class_name": {"required": true, "description": "Generated entrypoint class name."},
    "role": {"required": true, "description": "ECHO module role."},
    "kind": {"required": true, "description": "ECHO module kind."},
    "feature_id": {"required": true, "description": "Primary provided feature id."}
  },
  "requiredFiles": ["addons/{{module_id}}/build.gradle", "addons/{{module_id}}/src/main/resources/META-INF/echo.mod.json"],
  "defaultFeatures": ["testkit.example"],
  "safeEditZones": ["src/main/java/**", "src/main/resources/**", "docs/**"],
  "protectedFiles": ["src/generated/**", "managed installs", "user saves"],
  "recommendedAgentLanes": ["diagnostics_agent", "test_agent"],
  "validationCommands": [".\\gradlew validateEchoSdkTemplates"]
}
