{
  "schema": "echo.sdk.template.v1",
  "id": "echo-report",
  "name": "ECHO Report",
  "kind": "addon",
  "description": "Scaffold a report contract module shell using the shared report envelope vocabulary.",
  "fileSets": [
    "addon-module"
  ],
  "defaultValues": {
    "class_name": "EchoSdkReport",
    "kind": "report",
    "role": "report_contract",
    "feature_id": "report.generated",
    "display_name": "ECHO SDK Report"
  },
  "tokens": {
    "module_id": {"required": true, "description": "Lowercase ECHO module id."},
    "package_path": {"required": true, "description": "Generated Java package path."},
    "package_name": {"required": true, "description": "Generated Java package name."},
    "class_name": {"required": true, "description": "Generated entrypoint class name."},
    "role": {"required": true, "description": "ECHO module role."},
    "kind": {"required": true, "description": "ECHO module kind."},
    "feature_id": {"required": true, "description": "Primary provided feature id."}
  },
  "requiredFiles": [
    "addons/{{module_id}}/build.gradle",
    "addons/{{module_id}}/gradle.properties",
    "addons/{{module_id}}/src/main/java/{{package_path}}/{{class_name}}.java",
    "addons/{{module_id}}/src/main/java/{{package_path}}/contract/{{class_name}}ReportEnvelopeContract.java",
    "addons/{{module_id}}/src/main/resources/data/{{module_id}}/reports/{{module_id}}.report.json",
    "addons/{{module_id}}/src/main/resources/META-INF/echo.mod.json",
    "addons/{{module_id}}/src/main/resources/META-INF/echo.ai.json",
    "addons/{{module_id}}/src/main/templates/META-INF/neoforge.mods.toml",
    "addons/{{module_id}}/README.md",
    "addons/{{module_id}}/docs/{{module_id}}.md",
    "addons/{{module_id}}/src/test/validation/{{module_id}}.validation.json"
  ],
  "defaultFeatures": [
    "report.generated"
  ],
  "safeEditZones": [
    "src/main/java/**",
    "docs/**",
    "README.md"
  ],
  "protectedFiles": [
    "src/generated/**",
    "reports with secrets",
    "managed installs"
  ],
  "recommendedAgentLanes": [
    "diagnostics_agent",
    "release_agent"
  ],
  "validationCommands": [
    ".\\gradlew scanEchoWorkspace -PechoAddonSet=beta",
    ".\\gradlew validateEchoReports -PechoAddonSet=beta"
  ]
}
