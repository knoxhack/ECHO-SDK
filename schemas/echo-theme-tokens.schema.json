{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/knoxhack/ECHO-SDK/main/schemas/echo-theme-tokens.schema.json",
  "title": "ECHO Theme Tokens",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "ownerModule", "tokens"],
  "properties": {
    "schemaVersion": { "const": "echo.theme.tokens.v1" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*:[a-zA-Z0-9_/.-]+$"
    },
    "ownerModule": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_-]*$" },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["color", "font", "spacing", "radius", "shadow", "animation", "sound", "icon"]
          },
          "value": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
