{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/knoxhack/ECHO-SDK/main/schemas/echo-native-host.schema.json",
  "title": "ECHO Native Host",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "hostId", "runtimeMode", "lifecycleState", "supportedServices", "moduleGraph", "capabilityReport"],
  "properties": {
    "schemaVersion": { "const": "echo.native.host.v1" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*:[a-zA-Z0-9_/.-]+$"
    },
    "hostId": {
      "type": "string",
      "enum": ["neoforge", "echo_native", "echo_runtime_standalone", "standalone_engine"]
    },
    "runtimeMode": {
      "type": "string",
      "enum": ["neoforge", "echo_native", "echo_runtime_standalone", "standalone_engine"]
    },
    "lifecycleState": {
      "type": "string",
      "enum": ["discovered", "resolved", "loaded", "registered", "ready", "shutdown", "failed", "unsupported"]
    },
    "supportedServices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "moduleGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphId", "contentGraphFingerprint"],
      "properties": {
        "graphId": { "type": "string", "minLength": 1 },
        "contentGraphFingerprint": { "type": "string", "minLength": 1 },
        "moduleCount": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilityReport": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generatedAt", "status"],
      "properties": {
        "generatedAt": { "type": "string", "minLength": 1 },
        "status": { "enum": ["supported", "adapted", "fallback", "blocked"] }
      }
    }
  }
}
